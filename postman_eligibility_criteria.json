{
  "info": {
    "name": "ITAUQ - Eligibility Criteria",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_id", "value": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" },
    { "key": "questionnaire_id", "value": "" },
    { "key": "eligibility_criterion_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Create Questionnaire (prerequisite)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Evaluasi Usability App Wisata Kalsel\",\n  \"app_name\": \"WisataKu\",\n  \"description\": \"Evaluasi tahap 1 untuk skripsi\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('questionnaire_id', json.data.id);",
              "  console.log('Saved questionnaire_id:', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create Eligibility Criterion",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/eligibility-criteria",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statement\": \"Saya berdomisili di Kota Banjarbaru\",\n  \"criteria_order\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Has id and statement', function () {",
              "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.statement).to.eql('Saya berdomisili di Kota Banjarbaru');",
              "  pm.expect(json.data.criteria_order).to.eql(1);",
              "});",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('eligibility_criterion_id', json.data.id);",
              "  console.log('Saved eligibility_criterion_id:', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Create Eligibility Criterion (second)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/eligibility-criteria",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statement\": \"Saya berusia 18-25 tahun\",\n  \"criteria_order\": 2\n}"
        }
      }
    },
    {
      "name": "2. List Eligibility Criteria",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/eligibility-criteria",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Returns both criteria in order', function () {",
              "  pm.expect(json.data).to.be.an('array').with.lengthOf(2);",
              "  pm.expect(json.data[0].criteria_order).to.eql(1);",
              "  pm.expect(json.data[1].criteria_order).to.eql(2);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2b. List Eligibility Criteria (Super Admin)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/eligibility-criteria",
        "header": [
          { "key": "X-User-ID", "value": "00000000-0000-0000-0000-000000000001" },
          { "key": "X-User-Role", "value": "super_admin" }
        ]
      }
    },
    {
      "name": "3. Get Eligibility Criterion by ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/eligibility-criteria/{{eligibility_criterion_id}}",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Returns the criterion', function () {",
              "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get('eligibility_criterion_id'));",
              "  pm.expect(json.data.statement).to.eql('Saya berdomisili di Kota Banjarbaru');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update Eligibility Criterion",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/eligibility-criteria/{{eligibility_criterion_id}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statement\": \"Saya berdomisili di Kota Banjarbaru atau Martapura\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Statement was updated', function () {",
              "  pm.expect(json.data.statement).to.eql('Saya berdomisili di Kota Banjarbaru atau Martapura');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4b. Update Eligibility Criterion (partial - order only)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/eligibility-criteria/{{eligibility_criterion_id}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"criteria_order\": 5\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Order was updated, statement preserved', function () {",
              "  pm.expect(json.data.criteria_order).to.eql(5);",
              "  pm.expect(json.data.statement).to.eql('Saya berdomisili di Kota Banjarbaru atau Martapura');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Delete Eligibility Criterion",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/eligibility-criteria/{{eligibility_criterion_id}}",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: Create without statement (expect 400)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/eligibility-criteria",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"criteria_order\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: Wrong admin (expect 403)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/eligibility-criteria",
        "header": [
          { "key": "X-User-ID", "value": "11111111-1111-1111-1111-111111111111" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: Non-existent criterion (expect 404)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/eligibility-criteria/00000000-0000-0000-0000-000000000000",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
