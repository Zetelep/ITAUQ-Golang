{
  "info": {
    "name": "ITAUQ - Task Scenarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_id", "value": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" },
    { "key": "questionnaire_id", "value": "" },
    { "key": "task_scenario_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Create Questionnaire (prerequisite)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Evaluasi Usability App Wisata Kalsel\",\n  \"app_name\": \"WisataKu\",\n  \"description\": \"Evaluasi tahap 1 untuk skripsi\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('questionnaire_id', json.data.id);",
              "  console.log('Saved questionnaire_id:', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create Task Scenario",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/task-scenarios",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Mencari destinasi wisata terdekat\",\n  \"instruction\": \"Gunakan fitur pencarian untuk menemukan tempat wisata dalam radius 5km.\",\n  \"task_order\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('task_scenario_id', json.data.id);",
              "  console.log('Saved task_scenario_id:', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Create Task Scenario (second)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/task-scenarios",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Melihat detail tempat wisata\",\n  \"instruction\": \"Klik salah satu hasil pencarian dan lihat informasi lengkapnya.\",\n  \"task_order\": 2\n}"
        }
      }
    },
    {
      "name": "2. List Task Scenarios",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/task-scenarios",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "2b. List Task Scenarios (Super Admin)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/task-scenarios",
        "header": [
          { "key": "X-User-ID", "value": "00000000-0000-0000-0000-000000000001" },
          { "key": "X-User-Role", "value": "super_admin" }
        ]
      }
    },
    {
      "name": "3. Get Task Scenario by ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/task-scenarios/{{task_scenario_id}}",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "4. Update Task Scenario",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/task-scenarios/{{task_scenario_id}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Mencari destinasi wisata terdekat (updated)\",\n  \"instruction\": \"Gunakan fitur pencarian untuk menemukan tempat wisata dalam radius 10km.\"\n}"
        }
      }
    },
    {
      "name": "4b. Update Task Scenario (partial - order only)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/task-scenarios/{{task_scenario_id}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"task_order\": 5\n}"
        }
      }
    },
    {
      "name": "5. Delete Task Scenario",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/task-scenarios/{{task_scenario_id}}",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "Error: Create without title (expect 400)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/task-scenarios",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instruction\": \"Some instruction without title\"\n}"
        }
      }
    },
    {
      "name": "Error: Wrong admin (expect 403)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/task-scenarios",
        "header": [
          { "key": "X-User-ID", "value": "11111111-1111-1111-1111-111111111111" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "Error: Non-existent task scenario (expect 404)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/task-scenarios/00000000-0000-0000-0000-000000000000",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    }
  ]
}
