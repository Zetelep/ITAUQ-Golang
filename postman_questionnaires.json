{
  "info": {
    "name": "ITAUQ - Questionnaires",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_id", "value": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" },
    { "key": "questionnaire_id", "value": "" }
  ],
  "item": [
    {
      "name": "Create Questionnaire",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Evaluasi Usability App Wisata Kalsel\",\n  \"app_name\": \"WisataKu\",\n  \"description\": \"Evaluasi tahap 1 untuk skripsi\",\n  \"status\": \"draft\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('questionnaire_id', json.data.id);",
              "  console.log('Saved questionnaire_id:', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Questionnaire (minimal)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test Minimal\",\n  \"app_name\": \"TestApp\"\n}"
        }
      }
    },
    {
      "name": "List Questionnaires (Admin)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/questionnaires?page=1&page_size=20",
          "host": ["{{base_url}}"],
          "path": ["questionnaires"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        },
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "List Questionnaires (Super Admin - all)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/questionnaires?page=1&page_size=20",
          "host": ["{{base_url}}"],
          "path": ["questionnaires"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        },
        "header": [
          { "key": "X-User-ID", "value": "00000000-0000-0000-0000-000000000001" },
          { "key": "X-User-Role", "value": "super_admin" }
        ]
      }
    },
    {
      "name": "List Questionnaires (filter by status)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/questionnaires?status=draft&page=1&page_size=20",
          "host": ["{{base_url}}"],
          "path": ["questionnaires"],
          "query": [
            { "key": "status", "value": "draft" },
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        },
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "Get Questionnaire by ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "Get Questionnaire (wrong admin - expect 403)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}",
        "header": [
          { "key": "X-User-ID", "value": "11111111-1111-1111-1111-111111111111" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "description": "A different administrator should get 403"
      }
    },
    {
      "name": "Update Questionnaire",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Evaluasi Usability App Wisata Kalsel - Updated\",\n  \"status\": \"active\"\n}"
        }
      }
    },
    {
      "name": "Delete Questionnaire",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "Delete Questionnaire (wrong admin - expect 403)",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}",
        "header": [
          { "key": "X-User-ID", "value": "11111111-1111-1111-1111-111111111111" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    },
    {
      "name": "Get non-existent - expect 404",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/00000000-0000-0000-0000-000000000000",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      }
    }
  ]
}
