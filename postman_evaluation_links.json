{
  "info": {
    "name": "ITAUQ - Evaluation Links",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_id", "value": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" },
    { "key": "questionnaire_id", "value": "" },
    { "key": "evaluation_link_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Create Questionnaire (prerequisite)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Evaluasi Usability App Wisata Kalsel\",\n  \"app_name\": \"WisataKu\",\n  \"description\": \"Evaluasi tahap 1 untuk skripsi\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('questionnaire_id', json.data.id);",
              "  console.log('Saved questionnaire_id:', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create Evaluation Link (no expiry)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/evaluation-links",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Has token and url', function () {",
              "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.url).to.include(json.data.token);",
              "});",
              "pm.test('Active by default, no expiry', function () {",
              "  pm.expect(json.data.is_active).to.eql(true);",
              "  pm.expect(json.data.expires_at).to.eql(null);",
              "});",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('evaluation_link_id', json.data.id);",
              "  console.log('Saved evaluation_link_id:', json.data.id, 'token:', json.data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Create Evaluation Link (with expiry)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/evaluation-links",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expires_at\": \"2026-12-31T23:59:59Z\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Expiry saved', function () {",
              "  pm.expect(json.data.expires_at).to.not.eql(null);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. List Evaluation Links",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/evaluation-links",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Array of links', function () { pm.expect(json.data).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2b. List Evaluation Links (Super Admin)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/evaluation-links",
        "header": [
          { "key": "X-User-ID", "value": "00000000-0000-0000-0000-000000000001" },
          { "key": "X-User-Role", "value": "super_admin" }
        ]
      }
    },
    {
      "name": "3. Update Evaluation Link (deactivate)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/evaluation-links/{{evaluation_link_id}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Link deactivated', function () { pm.expect(json.data.is_active).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3b. Update Evaluation Link (reactivate + new expiry)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/evaluation-links/{{evaluation_link_id}}",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": true,\n  \"expires_at\": \"2027-06-30T23:59:59Z\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Reactivated', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.data.is_active).to.eql(true);",
              "  pm.expect(json.data.expires_at).to.not.eql(null);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Delete Evaluation Link",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/evaluation-links/{{evaluation_link_id}}",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: Create with past expiry (expect 400)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/evaluation-links",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expires_at\": \"2020-01-01T00:00:00Z\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 500 (validation via usecase error)', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: Wrong admin (expect 403)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/questionnaires/{{questionnaire_id}}/evaluation-links",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "11111111-1111-1111-1111-111111111111" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: Non-existent link (expect 404)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/evaluation-links/00000000-0000-0000-0000-000000000000",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
