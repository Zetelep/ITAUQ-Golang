{
  "info": {
    "name": "ITAUQ - Profile & First-login Password Change",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_id", "value": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" },
    { "key": "super_admin_id", "value": "11111111-2222-3333-4444-555555555555" },
    { "key": "new_password", "value": "newSecret!9" }
  ],
  "item": [
    {
      "name": "1. Get My Profile (must_change_password = true)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/profiles/me",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('must_change_password is true on first read', function () {",
              "  pm.expect(json.data.must_change_password).to.eql(true);",
              "});",
              "pm.test('role is administrator', function () {",
              "  pm.expect(json.data.role).to.eql('administrator');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get My Profile (Super Admin)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/profiles/me",
        "header": [
          { "key": "X-User-ID", "value": "{{super_admin_id}}" },
          { "key": "X-User-Role", "value": "super_admin" }
        ]
      }
    },
    {
      "name": "3. Change Password (first-login rotation)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/change-password",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"12345678\",\n  \"new_password\": \"{{new_password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('password updated successfully', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get My Profile (must_change_password = false)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/profiles/me",
        "header": [
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('must_change_password cleared after change', function () {",
              "  pm.expect(json.data.must_change_password).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Change Password (no current_password)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/change-password",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_password\": \"anotherSecret!9\"\n}"
        }
      }
    },
    {
      "name": "6. Change Password (too short -> 400)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/change-password",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_password\": \"short\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('rejects passwords under 8 chars', function () {",
              "  pm.expect(pm.response.code).to.eql(400);",
              "  var json = pm.response.json();",
              "  pm.expect(json.error.code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Change Password (unauthenticated -> 401)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/change-password",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_password\": \"anotherSecret!9\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('rejects missing auth header', function () {",
              "  pm.expect(pm.response.code).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Update My Profile (full_name)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/profiles/me",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Siti Aminah Putri\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('full_name updated', function () {",
              "  pm.expect(json.data.full_name).to.eql('Siti Aminah Putri');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Update My Profile (blank full_name -> 400)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/profiles/me",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{admin_id}}" },
          { "key": "X-User-Role", "value": "administrator" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"   \"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('rejects blank full_name', function () {",
              "  pm.expect(pm.response.code).to.eql(400);",
              "  var json = pm.response.json();",
              "  pm.expect(json.error.code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Get My Profile (unauthenticated -> 401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/profiles/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('rejects missing auth header', function () {",
              "  pm.expect(pm.response.code).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
